# ---- Aegis configuration (copy to .env) -------------------------------------------------------
AEGIS_ENVIRONMENT=development
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_FORMAT=console

AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
AEGIS_REDIS_URL=redis://localhost:6379/0
AEGIS_TEMPORAL_ADDRESS=localhost:7233
AEGIS_TEMPORAL_NAMESPACE=default

AEGIS_SIMULATOR_URL=http://localhost:8601
AEGIS_TELEMETRY_PROVIDER=simulator

# LLM: supply the key directly or point at a file that contains it
AEGIS_LLM_PROVIDER=openai
AEGIS_LLM_API_KEY_FILE=/home/skylark/Downloads/openai_api_key
# AEGIS_LLM_API_KEY=sk-...
AEGIS_LLM_REASONER_MODEL=gpt-5-mini
AEGIS_LLM_FAST_MODEL=gpt-5-nano
AEGIS_LLM_EMBEDDING_MODEL=text-embedding-3-small
AEGIS_LLM_REASONING_EFFORT=low

# Prometheus exporter for the worker and detector processes (set per process)
AEGIS_METRICS_PORT=9464

AEGIS_OTEL_ENABLED=false
AEGIS_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

AEGIS_API_PORT=8600
AEGIS_API_AUTH_MODE=disabled
# AEGIS_API_KEYS=dev-admin-key:admin:local-admin,dev-viewer-key:viewer:local-viewer
AEGIS_API_CORS_ORIGINS=["http://localhost:3600"]

AEGIS_DETECTION_INTERVAL_SECONDS=5
AEGIS_APPROVAL_TIMEOUT_SECONDS=900
