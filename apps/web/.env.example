# Base URL of the Aegis control-plane API (FastAPI). Inlined at build time.
NEXT_PUBLIC_AEGIS_API_URL=http://localhost:8600

# Optional API key sent as `X-Aegis-Key`. Leave empty in dev mode (auth disabled).
NEXT_PUBLIC_AEGIS_API_KEY=

# Optional: where the Temporal Web UI lives (workflow links open here).
NEXT_PUBLIC_TEMPORAL_UI_URL=http://localhost:8233
# Optional: Grafana / Prometheus links shown on /system.
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3000
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
