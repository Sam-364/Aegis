{
  "name": "aegis-web",
  "version": "0.1.0",
  "private": true,
  "description": "Aegis control console - flight recorder for the autonomous incident-response runtime",
  "scripts": {
    "dev": "next dev -p 3600",
    "build": "next build",
    "start": "next start -p 3000",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ./openapi.json -o ./src/lib/api-types.ts --alphabetize"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "d3-force": "^3.0.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
