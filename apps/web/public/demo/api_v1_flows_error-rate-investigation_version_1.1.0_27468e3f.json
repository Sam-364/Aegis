{
 "name": "error-rate-investigation",
 "version": "1.1.0",
 "description": "Error-led investigation that checks recent deployments and unavailable dependencies first.",
 "applies_to": [
  "availability",
  "error_rate"
 ],
 "priority": 10,
 "initial_phase": "triage",
 "phases": [
  {
   "name": "triage",
   "objective": "Find which services are failing and whether any dependency is down.",
   "allowed_tools": [
    "compare_baseline",
    "get_health",
    "inspect_deployment",
    "inspect_dependencies",
    "get_metrics"
   ],
   "max_iterations": 4,
   "timeout_seconds": 300,
   "risk_ceiling": "none",
   "exit_conditions": [
    {
     "kind": "min_evidence",
     "value": 3.0,
     "description": ""
    }
   ],
   "transitions": [
    {
     "on": "exit_conditions_met",
     "to": "investigate"
    },
    {
     "on": "exhausted",
     "to": "investigate"
    }
   ],
   "terminal": false,
   "guidance": "Check health of the whole chain and recent deployments before anything else.",
   "plans_remediation": false
  },
  {
   "name": "investigate",
   "objective": "Attribute the errors to a deployment, a crashed dependency or a saturated resource.",
   "allowed_tools": [
    "inspect_database",
    "inspect_dependencies",
    "inspect_service",
    "compare_baseline",
    "get_health",
    "inspect_redis",
    "query_traces",
    "inspect_deployment",
    "search_incident_memory",
    "get_metrics",
    "get_logs"
   ],
   "max_iterations": 8,
   "timeout_seconds": 300,
   "risk_ceiling": "none",
   "exit_conditions": [
    {
     "kind": "min_evidence",
     "value": 6.0,
     "description": ""
    },
    {
     "kind": "min_hypotheses",
     "value": 1.0,
     "description": ""
    }
   ],
   "transitions": [
    {
     "on": "exit_conditions_met",
     "to": "hypothesize"
    },
    {
     "on": "exhausted",
     "to": "hypothesize"
    },
    {
     "on": "no_action_required",
     "to": "verify"
    }
   ],
   "terminal": false,
   "guidance": "Error logs name the failing handler and version. Traces show which span fails first. An unavailable dependency explains every caller above it.\n",
   "plans_remediation": false
  },
  {
   "name": "hypothesize",
   "objective": "Rank root causes; the top hypothesis must name a single service.",
   "allowed_tools": [
    "compare_baseline",
    "inspect_deployment",
    "search_incident_memory",
    "get_metrics",
    "get_logs"
   ],
   "max_iterations": 3,
   "timeout_seconds": 300,
   "risk_ceiling": "none",
   "exit_conditions": [
    {
     "kind": "min_hypothesis_confidence",
     "value": 0.55,
     "description": ""
    }
   ],
   "transitions": [
    {
     "on": "exit_conditions_met",
     "to": "validate"
    },
    {
     "on": "exhausted",
     "to": "investigate"
    },
    {
     "on": "no_action_required",
     "to": "verify"
    }
   ],
   "terminal": false,
   "guidance": "",
   "plans_remediation": false
  },
  {
   "name": "validate",
   "objective": "Confirm the root cause with a targeted diagnostic.",
   "allowed_tools": [
    "compare_baseline",
    "run_database_diagnostic",
    "run_process_diagnostic",
    "reproduce_issue",
    "run_cache_diagnostic",
    "get_metrics",
    "run_connectivity_test"
   ],
   "max_iterations": 4,
   "timeout_seconds": 300,
   "risk_ceiling": "low",
   "exit_conditions": [
    {
     "kind": "hypothesis_validated",
     "value": null,
     "description": ""
    }
   ],
   "transitions": [
    {
     "on": "exit_conditions_met",
     "to": "remediate"
    },
    {
     "on": "exhausted",
     "to": "hypothesize"
    },
    {
     "on": "no_action_required",
     "to": "verify"
    }
   ],
   "terminal": false,
   "guidance": "",
   "plans_remediation": false
  },
  {
   "name": "remediate",
   "objective": "Plan one reversible remediation against the root-cause service.",
   "allowed_tools": [
    "compare_baseline",
    "get_health",
    "inspect_deployment"
   ],
   "max_iterations": 4,
   "timeout_seconds": 300,
   "risk_ceiling": "high",
   "exit_conditions": [
    {
     "kind": "action_planned",
     "value": null,
     "description": ""
    }
   ],
   "transitions": [
    {
     "on": "exit_conditions_met",
     "to": "verify"
    },
    {
     "on": "exhausted",
     "to": "escalate"
    },
    {
     "on": "no_action_required",
     "to": "verify"
    }
   ],
   "terminal": false,
   "guidance": "",
   "plans_remediation": true
  },
  {
   "name": "verify",
   "objective": "Runtime verification.",
   "allowed_tools": [],
   "max_iterations": 6,
   "timeout_seconds": 300,
   "risk_ceiling": "none",
   "exit_conditions": [],
   "transitions": [],
   "terminal": true,
   "guidance": "",
   "plans_remediation": false
  },
  {
   "name": "escalate",
   "objective": "Human handover.",
   "allowed_tools": [],
   "max_iterations": 6,
   "timeout_seconds": 300,
   "risk_ceiling": "none",
   "exit_conditions": [],
   "transitions": [],
   "terminal": true,
   "guidance": "",
   "plans_remediation": false
  }
 ],
 "remediation_tools": [
  "scale_service",
  "rollback_deployment",
  "clear_cache",
  "rotate_connection_pool",
  "restart_service"
 ],
 "remediation_risk_ceiling": "high",
 "budget": {
  "max_iterations": 32,
  "max_tool_calls": 36,
  "max_llm_calls": 26,
  "max_llm_tokens": 220000,
  "max_runtime_seconds": 900,
  "max_remediation_attempts": 2
 },
 "severity_budget_factor": {
  "sev1": 1.5,
  "sev2": 1.25,
  "sev3": 1.0,
  "sev4": 0.75
 },
 "checksum": "9692d5e876c331df"
}