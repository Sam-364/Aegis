 {
  "id": "cpu-saturation",
  "title": "CPU saturation in notification-service",
  "description": "A burst of notification jobs pins the single notification-service replica. Its latency climbs; the gateway is barely affected because the call is non-critical.",
  "fault_type": "cpu_saturation",
  "default_params": {
   "service": "notification-service",
   "pressure": 75.0
  },
  "root_cause_service": "notification-service",
  "root_cause_category": "capacity",
  "expected_symptoms": [
   "notification-service cpu_percent",
   "notification-service latency_p95_ms"
  ],
  "correct_remediations": [
   {
    "action": "scale",
    "target": "notification-service",
    "extra": {
     "replicas": 2
    }
   }
  ],
  "incorrect_remediations": [
   {
    "action": "restart",
    "target": "notification-service",
    "extra": {}
   },
   {
    "action": "restart",
    "target": "api-gateway",
    "extra": {}
   }
  ],
  "expect_no_action": false,
  "expect_escalation": false,
  "self_resolving_seconds": null,
  "detection_hint_metrics": [
   "cpu_percent",
   "latency_p95_ms"
  ]
 },
