{
 "name": "reproduce_issue",
 "version": "1",
 "description": "Issue several synthetic requests against a service and report the failure rate, latency and the failing upstream if any.",
 "category": "diagnostic",
 "risk": "low",
 "idempotent": true,
 "timeout_seconds": 10.0,
 "retry": {
  "max_attempts": 3,
  "initial_backoff_seconds": 0.5,
  "backoff_multiplier": 2.0,
  "max_backoff_seconds": 10.0
 },
 "capabilities": [],
 "allowed_environments": [
  "development",
  "staging",
  "production"
 ],
 "min_severity": null,
 "enabled": true,
 "arguments_schema": {
  "additionalProperties": false,
  "properties": {
   "service": {
    "title": "Service",
    "type": "string"
   },
   "endpoint": {
    "default": "/",
    "pattern": "^/[A-Za-z0-9_\\-/]*$",
    "title": "Endpoint",
    "type": "string"
   },
   "samples": {
    "default": 8,
    "description": "number of synthetic requests",
    "maximum": 20,
    "minimum": 1,
    "title": "Samples",
    "type": "integer"
   },
   "expectation": {
    "default": "",
    "title": "Expectation",
    "type": "string"
   }
  },
  "required": [
   "service"
  ],
  "title": "ReproduceArgs",
  "type": "object"
 },
 "produces_evidence": true,
 "verification_metrics": [],
 "used_in": {
  "api-latency-investigation@1.2.0": [
   "validate"
  ],
  "error-rate-investigation@1.1.0": [
   "validate"
  ],
  "incident-investigation@1.1.0": [
   "validate"
  ]
 }
}