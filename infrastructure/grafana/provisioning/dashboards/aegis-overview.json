          "legendFormat": "p50"
        },
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(aegis_incident_resolution_seconds_bucket[24h])) by (le))",
