{
  "uid": "aegis-simulated-infra",
  "title": "Aegis \u2014 Simulated Infrastructure",
  "tags": [
    "aegis",
    "simulator"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
